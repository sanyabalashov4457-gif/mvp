  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.12.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
